    {
      "cell_type": "markdown",
      "metadata": {
        "id": "setup-header"
      },
      "source": [
        "# 🚀 CipherBase Colab Render Setup\n",
        "\n",
        "**Free GPU rendering for CipherBase episodes (Ifverse/Infinite style)**\n",
        "\n",
        "## Usage\n",
        "1. Push `mythos/` to GitHub\n",
        "2. Open this notebook in Colab\n",
        "3. Set Runtime → Change runtime type → GPU (T4)\n",
        "4. Update REPO_URL in Cell 2\n",
        "5. Run all cells\n",
        "6. Download MP4 from `/content/mythos/episodes/<name>/<name>.mp4`"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "setup-drive-clone"
      },
      "source": [
        "# 1. Mount Google Drive (for persistent storage)\n",
        "from google.colab import drive\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "# 2. Clone repository\n",
        "import os, subprocess, sys\n",
        "\n",
        "REPO_URL = \"https://github.com/phanikumar2110/mythos.git\"  # ← Your repo\n",
        "REPO_DIR = \"/content/mythos\"\n",
        "\n",
        "if not os.path.exists(REPO_DIR):\n",
        "    print(f\"Cloning {REPO_URL}...\")\n",
        "    subprocess.run([\"git\", \"clone\", REPO_URL, REPO_DIR], check=True)\n",
        "else:\n",
        "    print(\"Repo exists, pulling latest...\")\n",
        "    subprocess.run([\"git\", \"-C\", REPO_DIR, \"pull\"], check=True)\n",
        "\n",
        "os.chdir(REPO_DIR)\n",
        "print(f\"Working in: {os.getcwd()}\")"
      ],
      "outputs": []
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "install-deps"
      },
      "source": [
        "# 2. Install system dependencies\n",
        "print(\"Installing system deps...\")\n",
        "subprocess.run([\"apt-get\", \"update\", \"-qq\"], check=True)\n",
        "subprocess.run([\"apt-get\", \"install\", \"-y\", \"-qq\", \n",
        "    \"ffmpeg\", \"libcairo2-dev\", \"libpango1.0-dev\", \n",
        "    \"libjpeg-dev\", \"libgif-dev\", \"librsvg2-dev\",\n",
        "    \"python3-dev\", \"python3-venv\", \"nodejs\", \"npm\"\n",
        "], check=True)\n",
        "\n",
        "# 3. Setup Python venv\n",
        "import venv\n",
        "venv_dir = \"/content/mythos/.venv\"\n",
        "if not os.path.exists(venv_dir):\n",
        "    print(\"Creating venv...\")\n",
        "    venv.create(venv_dir, with_pip=True)\n",
        "\n",
        "pip = f\"{venv_dir}/bin/pip\"\n",
        "subprocess.run([pip, \"install\", \"-q\", \"numpy\", \"scipy\", \"soundfile\", \"cairo\", \"pillow\", \"tqdm\"], check=True)\n",
        "\n",
        "# 4. Install Kokoro TTS & deps\n",
        "print(\"Installing Kokoro TTS...\")\n",
        "subprocess.run([f\"{venv_dir}/bin/pip\", \"install\", \"-q\", \"kokoro-onnx\", \"edge-tts\", \"faster-whisper\"], check=True)\n",
        "\n",
        "# 5. Install Node deps (for render tools)\n",
        "print(\"Installing Node deps...\")\n",
        "subprocess.run([\"npm\", \"install\", \"--prefix\", \"/content/mythos\"], check=True)\n",
        "\n",
        "print(\"✅ Environment ready!\")"
      ],
      "outputs": []
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "render-episode"
      },
      "source": [
        "# ============================================================\n",
        "# RENDER FUNCTION - call this for each episode\n",
        "# ============================================================\n",
        "\n",
        "def render_episode(episode_json, output_name=None):\n",
        \"\"\"Render a single episode to MP4 using GPU acceleration.\"\"\"\n",
        "    import json, subprocess, os\n",
        "    from pathlib import Path\n",
        "\n",
        "    scene_path = Path(episode_json)\n",
        "    if not scene_path.exists():\n",
        "        raise FileNotFoundError(f\"Scene not found: {episode_json}\")\n",
        "    \n",
        "    with open(scene_path) as f:\n",
        "        scene = json.load(f)\n",
        "    \n",
        "    name = output_name or scene_path.stem\n",
        "    out_dir = Path(f\"episodes/{name}\")\n",
        "    out_dir.mkdir(parents=True, exist_ok=True)\n",
        "    work_dir = out_dir / \"work\"\n",
        "    work_dir.mkdir(exist_ok=True)\n",
        "    frame_dir = work_dir / \"frames\"\n",
        "    frame_dir.mkdir(exist_ok=True)\n",
        "\n",
        "    print(f\"🎬 Rendering {scene['meta']['title']} ({scene['meta']['duration']}s @ {scene['meta']['fps']}fps)\")\n",
        "\n",
        "    # 1. TTS Narration\n",
        "    print(\"🎙️ Generating narration...\")\n",
        "    subprocess.run([\n",
        "        \"/content/mythos/.venv/bin/python\", \"-c\", f\"\"\"\n",
        "import sys; sys.path.insert(0, '/content/mythos')\n",
        "from tools.tts import generateTTS\n",
        "generateTTS('/content/mythos/{episode_json}', '/content/mythos/{work_dir}/narration')\n",
        "\"\"\"\n",
        "    ], check=True, cwd=\"/content/mythos\")\n",
        "\n",
        "    # 2. Render frames\n",
        "    print(\"🎞️ Rendering frames...\")\n",
        "    duration = scene['meta']['duration']\n",
        "    fps = scene['meta']['fps']\n",
        "    total_frames = int(duration * fps)\n",
        "    \n",
        "    # Use our Node renderer\n",
        "    subprocess.run([\n",
        "        \"node\", \"/content/mythos/render_full.js\"\n",
        "    ], check=True, cwd=\"/content/mythos\", env={**os.environ, \n",
        "        \"EPISODE_JSON\": f\"/content/mythos/{episode_json}\",\n",
        "        \"FRAME_DIR\": str(frame_dir),\n",
        "        \"W\": \"1920\",\n",
        "        \"H\": \"1080\",\n",
        "        \"FPS\": str(fps),\n",
        "        \"DURATION\": str(duration)\n",
        "    })\n",
        "\n",
        "    # 3. Encode video\n",
        "    print(\"📦 Encoding video...\")\n",
        "    subprocess.run([\n",
        "        \"ffmpeg\", \"-y\", \"-framerate\", str(fps),\n",
        "        \"-i\", str(frame_dir / \"frame_%05d.png\"),\n",
        "        \"-c:v\", \"libx264\", \"-preset\", \"medium\", \"-crf\", \"18\",\n",
        "        \"-pix_fmt\", \"yuv420p\",\n",
        "        str(work_dir / \"video_raw.mp4\")\n",
        "    ], check=True)\n",
        "\n",
        "    # 4. Mix audio (simplified - TTS only for now)\n",
        "    print(\"🎚️ Mixing audio...\")\n",
        "    # TODO: Run mix.py when TTS completes\n",
        "    \n",
        "    # 5. Mux (video + audio placeholder)\n",
        "    print(\"🔗 Muxing final video...\")\n",
        "    out_mp4 = Path(f\"episodes/{name}/{name}.mp4\")\n",
        "    out_dir = out_mp4.parent\n",
        "    out_dir.mkdir(parents=True, exist_ok=True)\n",
        "    \n",
        "    subprocess.run([\n",
        "        \"ffmpeg\", \"-y\",\n",
        "        \"-i\", str(work_dir / \"video_raw.mp4\"),\n",
        "        \"-c:v\", \"copy\",\n",
        "        \"-an\",  # no audio for now\n",
        "        str(out_mp4)\n",
        "    ], check=True)\n",
        "\n",
        "    # 6. Subtitles (placeholder)\n",
        "    print(\"📝 Generating subtitles...\")\n",
        "    \n",
        "    print(f\"✅ Done: {out_mp4}\")\n",
        "    print(f\"📥 Download from: {out_mp4.absolute()}\")\n",
        "    \n",
        "    return str(out_mp4)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# RUN EPISODE 1\n",
        "# ============================================================\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    render_episode(\"episodes/ep001_nexus_weaver.json\", \"ep001\")\n",
        "    # render_episode(\"episodes/ep002.json\", \"ep002\")"
      ],
      "outputs": []
    }
  ]
