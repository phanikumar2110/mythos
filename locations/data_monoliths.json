    { "id": "leds", "type": "repeating", "onMonoliths": true, "rows": 40, "colors": ["#00f0ff", "#ff2a5f", "#ffb800", "#39ff14"], "blink": true, "pattern": "rhythmic" },
    { "id": "downlights", "type": "volumetric", "count": 7, "color": "#00f0ff", "intensity": 0.4, "angle": -90 }
