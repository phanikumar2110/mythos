      { "id": "n03", "text": "Still calibrating. The Weaver's showing anomalies in Sector 7.", "startTime": 11.0, "duration": 4.0, "character": "cipher", "emotion": "focus", "speed": 0.95 },
      { "id": "n04", "text": "Reality-074 requesting feed of Reality-001. Observer paradox detected.", "startTime": 16.5, "duration": 3.5, "character": "voxel", "emotion": "spike", "speed": 1.1 },
      { "id": "n05", "text": "The alternate you... gave up everything for the stars. And is entirely alone.", "startTime": 20.0, "duration": 4.0, "character": "voxel", "emotion": "spike", "speed": 1.0 },
      { "id": "n06", "text": "You cannot outrun what you are.", "startTime": 25.0, "duration": 3.0, "character": "silhouette", "emotion": "hostile", "speed": 0.85 },
