# ============================================================
# RENDER FUNCTION - call this for each episode
# ============================================================

def render_episode(episode_json, output_name=None):
    """Render a single episode to MP4 using GPU acceleration."""
    import json, subprocess, os
    from pathlib import Path
    
    scene_path = Path(episode_json)
    if not scene_path.exists():
        raise FileNotFoundError(f"Scene not found: {episode_json}")
    
    with open(scene_path) as f:
        scene = json.load(scene_path)
    
    name = output_name or scene_path.stem
    out_dir = Path(f"episodes/{name}")
    out_dir.mkdir(parents=True, exist_ok=True)
    work_dir = out_dir / "work"
    work_dir.mkdir(exist_ok=True)
    
    print(f"🎬 Rendering {scene['meta']['title']} ({scene['meta']['duration']}s @ {scene['meta']['fps']}fps)")
    
    # 1. TTS Narration
    print("🎙️ Generating narration...")
    subprocess.run([
        "python", "-c", f"""
import sys; sys.path.insert(0, '.')
from tools.tts import generateTTS
generateTTS('{episode_json}', '{work_dir}/narration')
"""
    ], check=True, cwd=REPO_DIR)
    
    # 2. Render frames (CPU - but we can use Cairo which is fast)
    print("🎞️ Rendering frames...")
    frame_dir = Path(f"{work_dir}/frames")
    frame_dir.mkdir(exist_ok=True)
    
    # Use our Python renderer (Cairo-based, fast)
    duration = scene['meta']['duration']
    fps = scene['meta']['fps']
    total_frames = int(duration * fps)
    
    # We'll use the Node renderer via subprocess for now
    # TODO: Port renderer to Python for full Colab GPU acceleration
    subprocess.run([
        "node", "tools/render.js", str(scene_path), str(frame_dir)
    ], check=True, cwd=REPO_DIR)
    
    # 3. Encode video
    print("📦 Encoding video...")
    subprocess.run([
        "ffmpeg", "-y", "-framerate", str(fps),
        "-i", str(frame_dir / "frame_%05d.png"),
        "-c:v", "libx264", "-preset", "medium", "-crf", "18",
        "-pix_fmt", "yuv420p",
        str(work_dir / "video_raw.mp4")
    ], check=True)
    
    # 4. Mix audio (run mix.py)
    print("🎚️ Mixing audio...")
    subprocess.run([
        "python", "-c", f"""
from tools.mix import mix_audio
mix_audio('{work_dir}/narration', '{work_dir}/sfx', '{work_dir}/music', '{work_dir}/mix.wav', '{episode_json}')
"""
    ], check=True, cwd=REPO_DIR)
    
    # 5. Mux
    print("🔗 Muxing final video...")
    out_mp4 = Path(f"episodes/{name}/{name}.mp4")
    out_dir = out_mp4.parent
    out_dir.mkdir(parents=True, exist_ok=True)
    
    subprocess.run([
        "ffmpeg", "-y",
        "-i", str(work_dir / "video_raw.mp4"),
        "-i", str(work_dir / "mix.wav"),
        "-c:v", "copy", "-c:a", "aac", "-b:a", "192k",
        "-shortest", str(out_mp4)
    ], check=True)
    
    # 6. Subtitles
    print("📝 Generating subtitles...")
    subprocess.run([
        "python", "-c", f"""
from tools.subtitles import generate_subtitles
generate_subtitles('{episode_json}', '{out_dir}/{name}.srt')
"""
    ], check=True, cwd=REPO_DIR)
    
    print(f"✅ Done: {out_mp4}")
    print(f"📥 Download from: {out_mp4.absolute()}")
    
    return str(out_mp4)

