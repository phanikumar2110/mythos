    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# CipherBase Colab Render\n",
        "Free GPU rendering for CipherBase episodes\n",
        "1. Runtime > Change runtime type > GPU (T4)\n",
        "2. Run all cells\n",
        "3. MP4 downloads automatically"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 1. Mount Drive + Clone repo\n",
        "from google.colab import drive\n",
        "drive.mount('/content/drive')\n",
        "import os, subprocess\n",
        "REPO_DIR = '/content/mythos'\n",
        "if not os.path.exists(REPO_DIR):\n",
        "    print('Cloning...')\n",
        "    subprocess.run(['git', 'clone', 'https://github.com/phanikumar2110/mythos.git', '/content/mythos'], check=True)\n",
        "else:\n",
        "    subprocess.run(['git', '-C', '/content/mythos', 'pull'], check=True)\n",
        "os.chdir('/content/mythos')\n",
        "print('Ready:', os.getcwd())"
      ],
      "execution_count": null,
      "metadata": {},
      "outputs": []
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Install dependencies\n",
        "import subprocess, os\n",
        "print('Installing system deps...')\n",
        "subprocess.run(['apt-get', 'update', '-qq'], check=True)\n",
        "subprocess.run(['apt-get', 'install', '-y', '-qq',\n",
        "    'ffmpeg', 'libcairo2-dev', 'libpango1.0-dev',\n",
        "    'libjpeg-dev', 'libgif-dev', 'librsvg2-dev',\n",
        "    'python3-dev', 'python3-venv', 'nodejs', 'npm',\n",
        "    'python3-cairo', 'python3-gi', 'gir1.2-gtk-3.0']\n        ", check=True)\n",
        "\n",
        "# Install Python packages with --break-system-packages\n",
        "print('Installing Python packages...')\n",
        "import subprocess\n",
        "subprocess.run(['pip', 'install', '--break-system-packages', '-q',\n",
        "    'numpy', 'scipy', 'soundfile', 'cairocffi', 'pillow', 'tqdm'], check=True)\n",
        "\n",
        "subprocess.run(['pip', 'install', '--break-system-packages', '-q',\n",
        "    'kokoro-onnx', 'edge-tts', 'faster-whisper'], check=True)\n",
        "\n",
        "subprocess.run(['npm', 'install', '--prefix', '/content/mythos'] , check=True)\n",
        "\n",
        "print('Environment ready!')"
      ],
      "execution_count": null,
      "metadata": {},
      "outputs": []
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# RENDER EPISODE 1\n",
        "import json, subprocess, os\n",
        "from pathlib import Path\n",
        "scene_path = Path('episodes/ep001_nexus_weaver.json')\n",
        "with open(scene_path) as f:\n",
        "    scene = json.load(f)\n",
        "name = 'ep001'\n",
        "out_dir = Path('episodes/ep001')\n",
        "out_dir.mkdir(parents=True, exist_ok=True)\n",
        "work_dir = Path('episodes/ep001/work')\n",
        "work_dir.mkdir(exist_ok=True)\n",
        "frame_dir = work_dir / 'frames'\n",
        "frame_dir.mkdir(exist_ok=True)\n",
        "print(f\"Rendering {scene['meta']['title']} ({scene['meta']['duration']}s @ {scene['meta']['fps']}fps)\")",
        "import subprocess\n",
        "subprocess.run([\n",
        "    'python3', '-m', 'pip', 'run', '--break-system-packages', 'python', '-c',\n",
        "    \"import sys; sys.path.insert(0, '/content/mythos'); from tools.tts import generateTTS; generateTTS('episodes/ep001_nexus_weaver.json', 'episodes/ep001/work/narration')\"\n",
        "], check=True, cwd='/content/mythos')",
        "print('Rendering frames...')\n",
        "duration = 300\n",
        "fps = 24\n",
        "total_frames = int(duration * 24)\n",
        "import os\n",
        "env = os.environ.copy()\n",
        "env.update({\n",
        "    'EPISODE_JSON': 'episodes/ep001_nexus_weaver.json',\n",
        "    'FRAME_DIR': 'episodes/ep001/work/frames',\n",
        "    'W': '1920',\n",
        "    'H': '1080',\n",
        "    'FPS': '24',\n",
        "    'DURATION': '300'\n        })\n",
        "subprocess.run([\n",
        "    'node', 'render_full.js'\n",
        "], check=True, cwd='/content/mythos', env=env)"
      ],
      "execution_count": null,
      "metadata": {},
      "outputs": []
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Encode video\n",
        "import subprocess\n",
        "subprocess.run([\n",
        "    'ffmpeg', '-y', '-framerate', '24',\n",
        "    '-i', 'episodes/ep001/work/frames/frame_%05d.png',\n",
        "    '-c:v', 'libx264', '-preset', 'medium', '-crf', '18',\n",
        "    '-pix_fmt', 'yuv420p',\n",
        "    'episodes/ep001/work/video_raw.mp4'\n        ], check=True)\n",
        "subprocess.run([\n",
        "    'ffmpeg', '-y',\n",
        "    '-i', 'episodes/ep001/work/video_raw.mp4',\n",
        "    '-c:v', 'copy',\n",
        "    '-an',\n",
        "    'episodes/ep001/ep001.mp4'\n        ], check=True)\n",
        "print('Done! Downloading...')\n",
        "from google.colab import files\n",
        "files.download('episodes/ep001/ep001.mp4')"
      ],
      "execution_count": null,
      "metadata": {},
      "outputs": []
    }
  ]
