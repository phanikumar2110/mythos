  "audio": {
    "narration": [
      { "id": "n01", "text": "The hum of fluorescent tubes. The buzz of a thousand conversations. And in the center of it all — a wristband that changes everything.", "startTime": 1.5, "duration": 6, "character": "cipher", "emotion": "weary", "speed": 0.9 },
      { "id": "n02", "text": "Lucas didn't touch his tray. He only stared at the band around his wrist.", "startTime": 9, "duration": 4, "character": "cipher", "emotion": "neutral", "speed": 0.95 },
      { "id": "n03", "text": "Still calibrating?", "startTime": 13, "duration": 2, "character": "maya", "emotion": "curious", "speed": 1.0 },
      { "id": "n04", "text": "The Nexus Weaver. Standard issue at eighteen. To most, a harmless career simulator.", "startTime": 21, "duration": 5, "character": "cipher", "emotion": "weary", "speed": 0.9 },
      { "id": "n05", "text": "But Lucas had spent the last three nights chasing something else.", "startTime": 26, "duration": 4, "character": "cipher", "emotion": "focus", "speed": 0.9 },
      { "id": "n06", "text": "Reality-074. Aerospace engineer. New Geneva. Twin moons. Hands stained with engine oil.", "startTime": 36, "duration": 5, "character": "cipher", "emotion": "determined", "speed": 0.95 },
      { "id": "n07", "text": "Every version of him was accomplished. Every version had taken the leap he hadn't.", "startTime": 42, "duration": 5, "character": "voxel", "emotion": "exposition", "speed": 1.0 },
      { "id": "n08", "text": "Reality-112. Composer. Coastal town. Rain on glass. A finished symphony beside an empty glass.", "startTime": 56, "duration": 5, "character": "cipher", "emotion": "curious", "speed": 0.95 },
      { "id": "n09", "text": "A Lucas who spoke without stuttering. Who walked into rooms with certainty. Who hadn't let fear write his story.", "startTime": 62, "duration": 6, "character": "voxel", "emotion": "exposition", "speed": 1.0 },
      { "id": "n10", "text": "Just... looking around.", "startTime": 78, "duration": 2, "character": "cipher", "emotion": "shock", "speed": 1.0 },
      { "id": "n11", "text": "Doesn't it bother you? Knowing there's a world five degrees left where you made the right turn?", "startTime": 85, "duration": 6, "character": "cipher", "emotion": "focus", "speed": 0.95 },
      { "id": "n12", "text": "Those other versions aren't braver, Lucas. They just chose and dealt with the fallout.", "startTime": 92, "duration": 5, "character": "maya", "emotion": "grounded", "speed": 1.0 },
      { "id": "n13", "text": "Anomaly detected. Observer paradox. Reality-074 requesting feed of Reality-001.", "startTime": 108, "duration": 4, "character": "voxel", "emotion": "spike", "speed": 1.1 },
      { "id": "n14", "text": "The alternate Lucas wasn't smiling. He was staring through his terminal with hollow eyes.", "startTime": 113, "duration": 5, "character": "voxel", "emotion": "exposition", "speed": 1.0 },
      { "id": "n15", "text": "He looked at the messy table. The warm cafeteria. Maya with tea between her hands.", "startTime": 122, "duration": 5, "character": "cipher", "emotion": "shock", "speed": 0.95 },
      { "id": "n16", "text": "A whisper echoed through the audio bridge before the signal cut.", "startTime": 128, "duration": 4, "character": "cipher", "emotion": "shock", "speed": 0.9 },
      { "id": "n17", "text": "I gave up everything for the stars, and I'm entirely alone.", "startTime": 135, "duration": 5, "character": "voxel", "emotion": "exposition", "speed": 1.0 },
      { "id": "n18", "text": "You cannot outrun what you are.", "startTime": 148, "duration": 4, "character": "silhouette", "emotion": "hostile", "speed": 0.8 },
      { "id": "n19", "text": "The Weaver clicked off. Cold slate metal on plastic. Maya still waiting, unaware.", "startTime": 155, "duration": 5, "character": "cipher", "emotion": "shock", "speed": 0.95 },
      { "id": "n20", "text": "Someone kept it. The sea did not come back on its own.", "startTime": 165, "duration": 5, "character": "silhouette", "emotion": "hostile", "speed": 0.85 },
      { "id": "n21", "text": "Lucas unbuckled the strap. Laid the device flat. Picked up the tea.", "startTime": 172, "duration": 5, "character": "voxel", "emotion": "exposition", "speed": 1.0 },
      { "id": "n22", "text": "You're right. Let's figure out today first.", "startTime": 188, "duration": 4, "character": "cipher", "emotion": "determined", "speed": 0.95 },
      { "id": "n23", "text": "The grid doesn't care about intentions. It only executes.", "startTime": 195, "duration": 5, "character": "maya", "emotion": "grounded", "speed": 1.0 },
      { "id": "n24", "text": "But today — today we choose.", "startTime": 202, "duration": 4, "character": "cipher", "emotion": "determined", "speed": 0.95 },
      { "id": "n25", "text": "The anomaly logged. The paradox recorded. The system moves on.", "startTime": 215, "duration": 5, "character": "voxel", "emotion": "exposition", "speed": 1.0 },
      { "id": "n26", "text": "Lucas sipped the spiced tea. Rain streaked the concrete. Lightning flashed — and for a moment, the silhouette watched from the dark.", "startTime": 225, "duration": 8, "character": "cipher", "emotion": "neutral", "speed": 0.9 },
      { "id": "n27", "text": "The Weaver sat cold on the table. Its violet pulse faded. But the grid... the grid remembered.", "startTime": 258, "duration": 6, "character": "cipher", "emotion": "weary", "speed": 0.9 },
      { "id": "n28", "text": "Reality-074 still waiting. Reality-112 still composing. And somewhere, a single crimson slit eye blinked in the rain.", "startTime": 270, "duration": 8, "character": "voxel", "emotion": "exposition", "speed": 1.0 },
      { "id": "n29", "text": "Episode one complete. The Weaver awakens. The choice is made. The grid watches.", "startTime": 285, "duration": 6, "character": "cipher", "emotion": "neutral", "speed": 0.95 }
    ],
